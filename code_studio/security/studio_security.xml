<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Studio Groups -->
    <record id="group_studio_user" model="res.groups">
        <field name="name">Studio User</field>
        <field name="category_id" ref="base.module_category_administration" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_studio_manager" model="res.groups">
        <field name="name">Studio Manager</field>
        <field name="category_id" ref="base.module_category_administration" />
        <field name="implied_ids" eval="[(4, ref('group_studio_user'))]" />
    </record>

    <!-- Studio Model Rules -->
    <record id="studio_model_rule_user" model="ir.rule">
        <field name="name">Studio Model - User</field>
        <field name="model_id" ref="model_studio_model" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_studio_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="studio_model_rule_manager" model="ir.rule">
        <field name="name">Studio Model - Manager</field>
        <field name="model_id" ref="model_studio_model" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_studio_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <!-- Studio Field Rules -->
    <record id="studio_field_rule_user" model="ir.rule">
        <field name="name">Studio Field - User</field>
        <field name="model_id" ref="model_studio_field" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_studio_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="studio_field_rule_manager" model="ir.rule">
        <field name="name">Studio Field - Manager</field>
        <field name="model_id" ref="model_studio_field" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_studio_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <!-- Give system group access to Studio -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_studio_manager'))]" />
    </record>
</odoo>

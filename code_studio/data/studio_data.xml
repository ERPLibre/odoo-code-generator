<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Default Activity Types for Studio -->
        <record id="mail_activity_type_studio_approval" model="mail.activity.type">
            <field name="name">Studio Approval</field>
            <field name="summary">Approval Required</field>
            <field name="category">default</field>
            <field name="res_model">False</field>
            <field name="icon">fa-check-square-o</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
        </record>

        <!-- Default Email Template for Studio -->
        <record id="email_template_studio_notification" model="mail.template">
            <field name="name">Studio - General Notification</field>
            <field name="model_id" ref="base.model_res_users" />
            <field name="subject">Studio Notification: ${object.name}</field>
            <field name="email_from">${object.company_id.email | safe}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF;">
    <p>Hello,</p>
    <p>This is an automated notification from Odoo Studio.</p>
    <p>Best regards,<br/>
    ${object.company_id.name}</p>
</div>
            ]]></field>
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>

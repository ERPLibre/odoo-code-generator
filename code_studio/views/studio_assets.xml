    <!-- Studio OWL Templates -->
    <template id="studio_templates" name="Studio Community OWL Templates">
        <t t-call="code_studio.StudioEditor" />
        <t t-call="code_studio.StudioSidebar" />
        <t t-call="code_studio.StudioViewEditor" />
        <t t-call="code_studio.StudioFieldSelector" />
        <t t-call="code_studio.StudioPropertyEditor" />
        <t t-call="code_studio.StudioXmlEditor" />
        <t t-call="code_studio.StudioDashboard" />
    </template>

    <!-- Studio Editor Client Action -->
    <record id="action_studio_editor" model="ir.actions.client">
        <field name="name">Studio Editor</field>
        <field name="tag">studio_editor</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- Studio Dashboard Client Action -->
    <record id="action_studio_dashboard" model="ir.actions.client">
        <field name="name">Studio Dashboard</field>
        <field name="tag">studio_dashboard</field>
    </record>

    <!-- Additional Studio Styles -->
    <template id="studio_layout" name="Studio Layout">
        <style>
            /* Studio Color Variables */
            :root {
                --studio-primary: #875A7B;
                --studio-secondary: #00A09D;
                --studio-success: #28a745;
                --studio-danger: #dc3545;
                --studio-warning: #ffc107;
                --studio-info: #17a2b8;
                --studio-light: #f8f9fa;
                --studio-dark: #343a40;
                --studio-border: #dee2e6;
                --studio-shadow: rgba(0, 0, 0, 0.1);
            }

            /* Studio Animations */
            @keyframes studio-pulse {
                0% { transform: scale(1); }
                50% { transform: scale(1.05); }
                100% { transform: scale(1); }
            }

            @keyframes studio-slide-in {
                from { transform: translateX(-100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }

            @keyframes studio-fade-in {
                from { opacity: 0; }
                to { opacity: 1; }
            }

            /* Studio Utility Classes */
            .studio-animate-pulse {
                animation: studio-pulse 2s infinite;
            }

            .studio-animate-slide {
                animation: studio-slide-in 0.3s ease-out;
            }

            .studio-animate-fade {
                animation: studio-fade-in 0.3s ease-out;
            }

            .studio-card {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 4px var(--studio-shadow);
                padding: 1.5rem;
                margin-bottom: 1rem;
                transition: all 0.3s ease;
            }

            .studio-card:hover {
                box-shadow: 0 4px 8px var(--studio-shadow);
                transform: translateY(-2px);
            }

            .studio-badge {
                display: inline-block;
                padding: 0.25rem 0.5rem;
                font-size: 0.75rem;
                font-weight: 600;
                line-height: 1;
                text-align: center;
                white-space: nowrap;
                vertical-align: baseline;
                border-radius: 0.25rem;
            }

            .studio-badge-primary {
                background-color: var(--studio-primary);
                color: white;
            }

            .studio-badge-secondary {
                background-color: var(--studio-secondary);
                color: white;
            }

            /* Studio Tooltips */
            .studio-tooltip {
                position: relative;
                cursor: help;
            }

            .studio-tooltip::after {
                content: attr(data-tooltip);
                position: absolute;
                bottom: 100%;
                left: 50%;
                transform: translateX(-50%);
                background-color: var(--studio-dark);
                color: white;
                padding: 0.5rem;
                border-radius: 4px;
                font-size: 0.875rem;
                white-space: nowrap;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s;
                margin-bottom: 0.5rem;
            }

            .studio-tooltip:hover::after {
                opacity: 1;
            }

            /* Studio Loading States */
            .studio-loading {
                position: relative;
                pointer-events: none;
                opacity: 0.6;
            }

            .studio-loading::after {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 2rem;
                height: 2rem;
                border: 3px solid var(--studio-light);
                border-top-color: var(--studio-primary);
                border-radius: 50%;
                animation: spin 1s linear infinite;
            }

            @keyframes spin {
                to { transform: translate(-50%, -50%) rotate(360deg); }
            }

            /* Studio Drag and Drop */
            .studio-draggable {
                cursor: move;
                user-select: none;
            }

            .studio-dragging {
                opacity: 0.5;
                cursor: grabbing;
            }

            .studio-drop-zone {
                border: 2px dashed var(--studio-border);
                min-height: 60px;
                border-radius: 4px;
                transition: all 0.3s ease;
                position: relative;
            }

            .studio-drop-zone::before {
                content: "Drop here";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                color: #adb5bd;
                font-size: 0.875rem;
                opacity: 0;
                transition: opacity 0.3s;
            }

            .studio-drop-zone:empty::before {
                opacity: 1;
            }

            .studio-drop-active {
                border-color: var(--studio-primary);
                background-color: rgba(135, 90, 123, 0.1);
            }

            /* Studio Responsive Grid */
            .studio-grid {
                display: grid;
                gap: 1rem;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            }

            @media (min-width: 768px) {
                .studio-grid-md-2 { grid-template-columns: repeat(2, 1fr); }
                .studio-grid-md-3 { grid-template-columns: repeat(3, 1fr); }
                .studio-grid-md-4 { grid-template-columns: repeat(4, 1fr); }
            }

            @media (min-width: 992px) {
                .studio-grid-lg-2 { grid-template-columns: repeat(2, 1fr); }
                .studio-grid-lg-3 { grid-template-columns: repeat(3, 1fr); }
                .studio-grid-lg-4 { grid-template-columns: repeat(4, 1fr); }
            }

            /* Studio Editor Specific */
            .o_studio_editor {
                height: 100vh;
                display: flex;
                flex-direction: column;
                background-color: var(--studio-light);
            }

            .o_studio_navbar {
                background-color: white;
                border-bottom: 1px solid var(--studio-border);
                padding: 0.75rem 1rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: 0 2px 4px var(--studio-shadow);
                z-index: 1000;
            }

            .o_studio_navbar_title {
                font-size: 1.25rem;
                font-weight: 600;
                color: var(--studio-dark);
                margin: 0;
            }

            .o_studio_navbar_actions {
                display: flex;
                gap: 0.5rem;
                align-items: center;
            }

            /* Studio Sidebar Specific */
            .o_studio_sidebar {
                width: 320px;
                background-color: white;
                border-right: 1px solid var(--studio-border);
                height: 100%;
                display: flex;
                flex-direction: column;
                transition: width 0.3s ease;
            }

            .o_studio_sidebar.collapsed {
                width: 60px;
            }

            .o_studio_sidebar_header {
                padding: 1rem;
                border-bottom: 1px solid var(--studio-border);
            }

            .o_studio_sidebar_search {
                position: relative;
            }

            .o_studio_sidebar_search input {
                width: 100%;
                padding: 0.5rem 2.5rem 0.5rem 1rem;
                border: 1px solid var(--studio-border);
                border-radius: 4px;
                font-size: 0.875rem;
            }

            .o_studio_sidebar_search_icon {
                position: absolute;
                right: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
            }

            /* Studio Property Editor */
            .o_studio_property_editor {
                width: 320px;
                background-color: white;
                border-left: 1px solid var(--studio-border);
                padding: 1rem;
                overflow-y: auto;
            }

            .o_studio_property_group {
                margin-bottom: 1.5rem;
            }

            .o_studio_property_group_title {
                font-size: 0.875rem;
                font-weight: 600;
                text-transform: uppercase;
                color: #6c757d;
                margin-bottom: 0.75rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .o_studio_property_row {
                margin-bottom: 0.75rem;
            }

            .o_studio_property_label {
                display: block;
                font-size: 0.875rem;
                font-weight: 500;
                color: var(--studio-dark);
                margin-bottom: 0.25rem;
            }

            .o_studio_property_input {
                width: 100%;
                padding: 0.375rem 0.75rem;
                font-size: 0.875rem;
                border: 1px solid var(--studio-border);
                border-radius: 4px;
                transition: border-color 0.15s ease-in-out;
            }

            .o_studio_property_input:focus {
                border-color: var(--studio-primary);
                outline: 0;
                box-shadow: 0 0 0 0.2rem rgba(135, 90, 123, 0.25);
            }

            /* Studio View Editor Canvas */
            .o_studio_view_editor_canvas {
                flex: 1;
                padding: 2rem;
                overflow: auto;
                background-color: #f5f5f5;
                background-image:
                    linear-gradient(45deg, #fafafa 25%, transparent 25%),
                    linear-gradient(-45deg, #fafafa 25%, transparent 25%),
                    linear-gradient(45deg, transparent 75%, #fafafa 75%),
                    linear-gradient(-45deg, transparent 75%, #fafafa 75%);
                background-size: 20px 20px;
                background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
            }

            .o_studio_view_container {
                max-width: 1200px;
                margin: 0 auto;
                background-color: white;
                border-radius: 8px;
                box-shadow: 0 4px 6px var(--studio-shadow);
                min-height: 600px;
                padding: 2rem;
            }

            /* Studio Element States */
            .studio-element {
                position: relative;
                transition: all 0.2s ease;
            }

            .studio-element-hover {
                outline: 2px dashed var(--studio-info);
                outline-offset: 2px;
            }

            .studio-element-selected {
                outline: 2px solid var(--studio-primary);
                outline-offset: 2px;
            }

            .studio-element-selected::after {
                content: "";
                position: absolute;
                top: -8px;
                right: -8px;
                width: 16px;
                height: 16px;
                background-color: var(--studio-primary);
                border-radius: 50%;
                border: 2px solid white;
                box-shadow: 0 2px 4px var(--studio-shadow);
            }

            /* Studio Toast Notifications */
            .studio-toast {
                position: fixed;
                top: 1rem;
                right: 1rem;
                min-width: 300px;
                background-color: white;
                border-radius: 4px;
                box-shadow: 0 4px 6px var(--studio-shadow);
                padding: 1rem;
                z-index: 9999;
                animation: studio-slide-in 0.3s ease-out;
            }

            .studio-toast-success {
                border-left: 4px solid var(--studio-success);
            }

            .studio-toast-error {
                border-left: 4px solid var(--studio-danger);
            }

            .studio-toast-warning {
                border-left: 4px solid var(--studio-warning);
            }

            .studio-toast-info {
                border-left: 4px solid var(--studio-info);
            }
        </style>
    </template>


<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Studio Main Menu -->
    <menuitem
        id="studio_main_menu"
        name="Studio"
        sequence="100"
        groups="base.group_system"
        web_icon="code_studio,static/description/icon.png"
    />

    <!-- Studio Dashboard -->
    <record id="studio_dashboard_action" model="ir.actions.client">
        <field name="name">Studio Dashboard</field>
        <field name="tag">studio_dashboard</field>
    </record>

    <menuitem
        id="studio_dashboard_menu"
        name="Dashboard"
        parent="studio_main_menu"
        action="studio_dashboard_action"
        sequence="1"
    />

    <!-- Models Menu -->
    <menuitem id="studio_models_menu" name="Models" parent="studio_main_menu" sequence="10" />

    <!-- Configuration Menu -->
    <menuitem id="studio_configuration_menu" name="Configuration" parent="studio_main_menu" sequence="100" />
</odoo>

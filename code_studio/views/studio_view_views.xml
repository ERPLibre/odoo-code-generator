<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Studio View Form View -->
    <record id="studio_view_view_form" model="ir.ui.view">
        <field name="name">studio.view.form</field>
        <field name="model">studio.view</field>
        <field name="arch" type="xml">
            <form string="Studio View">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="type" />
                            <field name="studio_model_id" />
                            <field name="model" invisible="1" />
                            <field name="view_id" invisible="1" />
                        </group>
                        <group>
                            <field name="priority" />
                            <field name="mode" />
                            <field name="inherit_id" domain="[('model', '=', model)]" invisible="mode != 'extension'" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Architecture" name="architecture">
                            <group>
                                <field name="arch_base" widget="ace" options="{'mode': 'xml'}" />
                            </group>
                        </page>
                        <page string="Studio Modifications" name="studio_modifications">
                            <group>
                                <field name="arch_studio" widget="ace" options="{'mode': 'xml'}" />
                            </group>
                        </page>
                        <page string="Groups" name="groups">
                            <field name="groups_id">
                                <list string="Groups">
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

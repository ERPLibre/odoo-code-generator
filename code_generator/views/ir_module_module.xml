<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_filter_inherit" model="ir.ui.view">
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.view_module_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <filter string='Code Generator' name='code_generator' domain="[('header_manifest', '!=', False)]" />
            </xpath>
        </field>
    </record>

    <record id="ir_module_module_module_module_action_window" model="ir.actions.act_window">
        <field name="name">Module module</field>
        <field name="res_model">ir.module.module</field>
        <field name="context">{'search_default_code_generator': 1}</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
